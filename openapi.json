{
  "openapi": "3.1.0",
  "info": {
    "title": "x402 Trends Server",
    "version": "2.0.0",
    "description": "Production x402 API on Base Mainnet. Paid endpoints accept real USDC through x402."
  },
  "servers": [
    {
      "url": "https://x402-trends-server.onrender.com"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "summary": "Server information",
        "responses": {
          "200": {
            "description": "Server information"
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "Server is healthy"
          }
        }
      }
    },
    "/api/trends": {
      "get": {
        "summary": "Get latest space trends",
        "description": "Returns the five newest spaceflight news articles. Requires an x402 payment of $0.02 USDC on Base Mainnet.",
        "responses": {
          "200": {
            "description": "Paid request succeeded"
          },
          "402": {
            "description": "x402 payment required"
          },
          "502": {
            "description": "Upstream news provider failed"
          }
        }
      }
    },
    "/api/scrape": {
      "post": {
        "summary": "Extract webpage text",
        "description": "Fetches a public HTTP or HTTPS webpage and returns cleaned text. Requires an x402 payment of $0.005 USDC on Base Mainnet.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "url"
                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "format": "uri"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Paid request succeeded"
          },
          "400": {
            "description": "Invalid or blocked URL"
          },
          "402": {
            "description": "x402 payment required"
          },
          "415": {
            "description": "Unsupported content type"
          },
          "502": {
            "description": "Remote website failed"
          }
        }
      }
    },
    "/api/parse-receipt": {
      "post": {
        "summary": "Parse receipt text",
        "description": "Extracts line items, subtotal, tax, and total from raw receipt text. Requires an x402 payment of $0.05 USDC on Base Mainnet.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "text"
                ],
                "properties": {
                  "text": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Paid request succeeded"
          },
          "400": {
            "description": "Invalid receipt text"
          },
          "402": {
            "description": "x402 payment required"
          },
          "500": {
            "description": "Receipt parsing failed"
          }
        }
      }
    }
  }
}
